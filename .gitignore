/node_modules

# Excel / spreadsheet data files — never commit these
*.xlsx
*.xlsm
*.xls
*.csv
~$*.xlsx

# Login sessions — LOCAL ONLY, never push (these are auth tokens)
storageState*.json

# Temp / backup
*.bak
*.tmp

# Generated chunking + per-run artifacts (orchestrate.js)
chunks/
report_*.txt
report_latest.json

# Excel backups / run-specific output lists (regenerated, not source)
*.prebackfill
cleanup_list.txt
duplicate_epr_list.txt
*_FINAL_REPORT.xlsx
PP_PENDING.xlsx
PET_PENDING.xlsx
